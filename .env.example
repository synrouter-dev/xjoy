# ── Xjoy 环境变量配置 ─────────────────────────────────────────────────────
# 复制此文件为 .env.local 用于本地开发。
# 生产环境 (Vercel)：在 Vercel Dashboard → Settings → Environment Variables 设置
#   详见 docs/DEPLOY.md

# ═════════════════════════════════════════════════════════════════════════════
# 数据库 (必需)
# ═════════════════════════════════════════════════════════════════════════════
# 本地开发：本地 PostgreSQL（Paperclip 内嵌或自制）
# 生产环境 (Vercel)：Neon serverless PostgreSQL — 使用 Pooled connection
#   1. 在 https://neon.tech 创建免费项目
#   2. 在 Connection Details 中选择 "Pooled connection"
#   3. 复制连接字符串（格式见下方）
#   4. 在 Vercel Dashboard → Settings → Environment Variables 设置 DATABASE_URL
#
#   Neon 连接字符串格式（pooled）：
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/xjoy?sslmode=require
#
#   首次部署前，需运行数据库迁移和种子数据导入：
#   DATABASE_URL="<neon-url>" pnpm db:migrate
#   DATABASE_URL="<neon-url>" pnpm db:seed
DATABASE_URL="postgresql://user:password@localhost:5432/xjoy"

# ═════════════════════════════════════════════════════════════════════════════
# AI — LLM (必需)
# ═════════════════════════════════════════════════════════════════════════════
# 推荐：Anthropic API Key 直连（低延迟，~3-5s）
#   ANTHROPIC_API_KEY="sk-ant-..."  (不设置 ANTHROPIC_BASE_URL)
#   默认模型：claude-haiku-4-5-20251001
#
# 替代：DeepSeek 代理（较高延迟，~7s，仅开发使用）
#   ANTHROPIC_API_KEY="sk-..."      (DeepSeek API key)
#   ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
#   ANTHROPIC_MODEL="deepseek-chat"
ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
# ANTHROPIC_MODEL="deepseek-chat"

# ═════════════════════════════════════════════════════════════════════════════
# 向量嵌入 (可选 — 不设置则回退到全文搜索)
# ═════════════════════════════════════════════════════════════════════════════
# OpenAI API Key 用于生成经文向量嵌入（text-embedding-3-small）
# 不设置时，RAG 管道仅使用 PostgreSQL 全文搜索，仍可正常工作
# OPENAI_API_KEY="sk-..."
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ═════════════════════════════════════════════════════════════════════════════
# Sentry 错误追踪 (推荐)
# ═════════════════════════════════════════════════════════════════════════════
# 生产环境必须设置。开发环境可留空跳过。
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ═════════════════════════════════════════════════════════════════════════════
# 应用配置
# ═════════════════════════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 数据库连接池最大连接数（默认 10）
# DB_MAX_CONNECTIONS="10"
