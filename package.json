{
  "name": "xjoy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "data:fetch": "tsx scripts/fetch_kjv.ts",
    "data:crossrefs": "tsx scripts/fetch_crossrefs.ts",
    "data:embeddings": "tsx scripts/generate_embeddings.ts",
    "db:migrate": "pnpm --filter @xjoy/db migrate",
    "db:seed": "pnpm --filter @xjoy/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@9.15.4"
}
